    WAREHOUSE_DB_HOST: ${WAREHOUSE_DB_HOST:-warehouse-db}
    WAREHOUSE_DB_PORT: ${WAREHOUSE_DB_PORT:-5432}
    WAREHOUSE_DB_NAME: ${WAREHOUSE_DB_NAME:-retail}
    WAREHOUSE_DB_USER: ${WAREHOUSE_DB_USER:-retail_user}
    WAREHOUSE_DB_PASSWORD: ${WAREHOUSE_DB_PASSWORD:-retail_pass}
    S3_ENDPOINT_URL: ${S3_ENDPOINT_URL:-http://minio:9000}
    S3_BUCKET: ${S3_BUCKET:-retail-lakehouse}
    AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID:-minioadmin}
    AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY:-minioadmin}

# AWS region (filled in for real once you provision RDS/S3 — see infra/provision_aws.sh)
AWS_REGION=af-south-1
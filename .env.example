# Copy this to .env and fill in real values before deploying to AWS.
# Locally, docker-compose.yml already has working defaults for
# warehouse-db and MinIO — you don't strictly need this file until
# you point WAREHOUSE_DB_HOST/S3_* at real AWS.

WAREHOUSE_DB_HOST=warehouse-db
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=retail
WAREHOUSE_DB_USER=retail_user
WAREHOUSE_DB_PASSWORD=retail_pass

# S3 / MinIO — bronze landing zone
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=retail-lakehouse
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# AWS region (filled in for real once you provision RDS/S3 — see infra/provision_aws.sh)
AWS_REGION=af-south-1
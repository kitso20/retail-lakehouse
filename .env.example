# Copy this to .env and fill in real values before deploying to AWS.
# Locally, docker-compose.yml already has working defaults — you don't
# strictly need this file until you point WAREHOUSE_DB_HOST at RDS.

WAREHOUSE_DB_HOST=warehouse-db
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=weather
WAREHOUSE_DB_USER=weather_user
WAREHOUSE_DB_PASSWORD=change_me

# AWS (filled in when we get to the deploy step)
AWS_REGION=af-south-1
S3_RAW_BUCKET=your-bucket-name-here

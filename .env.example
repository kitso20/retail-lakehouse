# Copy to .env before first run:   cp .env.example .env
#
# The values below start the FULL local stack (warehouse-db + MinIO) with
# zero AWS setup. For real AWS (RDS + S3), run infra/provision_aws.sh and
# replace the values it prints — the important convention being:
#   S3_ENDPOINT_URL blank  ->  real AWS S3
#   S3_ENDPOINT_URL set    ->  that endpoint (local MinIO below)

# --- Warehouse (Postgres) ---
WAREHOUSE_DB_HOST=warehouse-db
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=retail
WAREHOUSE_DB_USER=retail_user
WAREHOUSE_DB_PASSWORD=retail_pass

# --- Bronze zone (S3-compatible object storage) ---
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=retail-lakehouse
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=af-south-1
